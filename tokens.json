{
  "meta": {
    "name": "터치 데스크 램프",
    "version": "1.0.0",
    "updated": "2026-11-24"
  },

  "color": {
    "primitive": {
      "linen-300":  "#E4DED4",
      "linen-100":  "#EEE9E1",
      "ash-500":    "#B7ADA2",
      "pine-500":   "#7A857C",
      "walnut-300": "#6E5848",
      "walnut-500": "#5A3B28",
      "walnut-900": "#2E1E14"
    },
    "semantic": {
      "bg-canvas":    "{color.primitive.linen-300}",
      "bg-surface":   "{color.primitive.linen-100}",
      "bg-signal":    "{color.primitive.walnut-500}",
      "fg-primary":   "{color.primitive.walnut-900}",
      "fg-secondary": "{color.primitive.walnut-500}",
      "fg-muted":     "{color.primitive.walnut-300}",
      "fg-signal":    "{color.primitive.walnut-500}",
      "border-hairline": "{color.primitive.ash-500}"
    }
  },

  "typography": {
    "family": {
      "text": "Pretendard, system-ui, sans-serif",
      "mono": "'SF Mono', ui-monospace, monospace"
    },
    "weight": { "regular": 400, "medium": 500, "bold": 700 },
    "size": {
      "3xs": "11px",
      "2xs": "12px",
      "xs":  "14px",
      "sm":  "16px",
      "md":  "20px",
      "lg":  "28px",
      "xl":  "40px",
      "2xl": "56px"
    },
    "leading": { "tight": 1.1, "snug": 1.3, "normal": 1.6 },
    "tracking": { "heading": "-0.02em", "label": "0.08em", "body": "0" }
  },

  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "96px"
  },

  "radius": {
    "none": "0px",
    "sm":   "4px",
    "md":   "8px",
    "lg":   "16px",
    "pill": "999px"
  },

  "breakpoint": {
    "sm": "480px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1440px"
  },

  "motion": {
    "duration": { "fast": "120ms", "base": "240ms", "slow": "480ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter":    "cubic-bezier(0, 0, 0, 1)",
      "exit":     "cubic-bezier(0.4, 0, 1, 1)"
    }
  },

  "component": {
    "button": {
      "height":        "44px",
      "padding-x":     "{space.5}",
      "radius":        "{radius.none}",
      "font-size":     "{typography.size.xs}",
      "font-weight":   "{typography.weight.medium}",
      "tracking":      "{typography.tracking.label}"
    },
    "field": {
      "height":        "44px",
      "padding-x":     "{space.4}",
      "radius":        "{radius.none}",
      "border-width":  "1px",
      "textarea-min":  "120px"
    },
    "card": {
      "padding":       "{space.5}",
      "radius":        "{radius.none}",
      "media-ratio":   "4 / 3",
      "gap":           "{space.4}"
    },
    "grid": {
      "columns":       12,
      "gutter":        "{space.5}",
      "margin":        "{space.6}",
      "max-width":     "1200px"
    }
  }
}
