{
  "meta": {
    "name": "여기에 서비스 이름을 적으세요",
    "version": "1.0.0",
    "updated": "2026-11-23"
  },

  "color": {
    "primitive": {
      "black":      "#0B0B0C",
      "gray-900":   "#141518",
      "gray-700":   "#2A2D33",
      "gray-500":   "#6E737D",
      "gray-300":   "#B9BDC5",
      "gray-100":   "#E8EAEE",
      "white":      "#FFFFFF",
      "accent-500": "#4F7CFF",
      "accent-300": "#8AA7FF",
      "accent-700": "#2E57C8"
    },
    "semantic": {
      "bg-canvas":    "{color.primitive.black}",
      "bg-surface":   "{color.primitive.gray-900}",
      "bg-signal":    "{color.primitive.accent-500}",
      "fg-primary":   "{color.primitive.white}",
      "fg-secondary": "{color.primitive.gray-300}",
      "fg-muted":     "{color.primitive.gray-500}",
      "fg-signal":    "{color.primitive.accent-300}",
      "border-hairline": "{color.primitive.gray-700}"
    }
  },

  "typography": {
    "family": {
      "text": "Pretendard, system-ui, sans-serif",
      "mono": "'SF Mono', ui-monospace, monospace"
    },
    "weight": { "regular": 400, "medium": 500, "bold": 700 },
    "size": {
      "3xs": "11px",
      "2xs": "12px",
      "xs":  "14px",
      "sm":  "16px",
      "md":  "20px",
      "lg":  "28px",
      "xl":  "40px",
      "2xl": "56px"
    },
    "leading": { "tight": 1.1, "snug": 1.3, "normal": 1.6 },
    "tracking": { "heading": "-0.02em", "label": "0.08em", "body": "0" }
  },

  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "96px"
  },

  "radius": {
    "none": "0px",
    "sm":   "4px",
    "md":   "8px",
    "lg":   "16px",
    "pill": "999px"
  },

  "breakpoint": {
    "sm": "480px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1440px"
  },

  "motion": {
    "duration": { "fast": "120ms", "base": "240ms", "slow": "480ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter":    "cubic-bezier(0, 0, 0, 1)",
      "exit":     "cubic-bezier(0.4, 0, 1, 1)"
    }
  },

  "component": {
    "button": {
      "height":        "44px",
      "padding-x":     "{space.5}",
      "radius":        "{radius.none}",
      "font-size":     "{typography.size.xs}",
      "font-weight":   "{typography.weight.medium}",
      "tracking":      "{typography.tracking.label}"
    },
    "field": {
      "height":        "44px",
      "padding-x":     "{space.4}",
      "radius":        "{radius.none}",
      "border-width":  "1px",
      "textarea-min":  "120px"
    },
    "card": {
      "padding":       "{space.5}",
      "radius":        "{radius.none}",
      "media-ratio":   "4 / 3",
      "gap":           "{space.4}"
    },
    "grid": {
      "columns":       12,
      "gutter":        "{space.5}",
      "margin":        "{space.6}",
      "max-width":     "1200px"
    }
  }
}
